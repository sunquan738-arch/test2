#include <iostream>
#include <vector>
using namespace std;

const int MAX = 100005;
vector<int> adj[MAX];
bool visited[MAX];

void dfs(int v)
{
    visited[v] = true;
    cout << v << " ";
    for (int u : adj[v])
    {
        if (!visited[u])
        {
            dfs(u);
        }
    }
}

int main()
{
    int n, m;
    cin >> n >> m;
    for (int i = 0; i < m; i++)
    {
        int a, b;
        cin >> a >> b;
        adj[a].push_back(b);
        adj[b].push_back(a);
    }
    dfs(1);
    return 0;
}
